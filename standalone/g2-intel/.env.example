# ──────────────────────────────────────────────────────────────
# QuickEnrich G2 Intel — environment configuration
# Copy this file to `.env` and fill in your API keys.
# ──────────────────────────────────────────────────────────────

# REQUIRED: Serper (https://serper.dev) — Google search API. $50/mo for 50k searches.
SERPER_API_KEY=

# STRONGLY RECOMMENDED: scrape.do (https://scrape.do) — bypasses DataDome on G2.
# Without it, the script falls back to Google search and will find ~10 products/category.
SCRAPE_DO_API_KEY=

# REQUIRED: pick one LLM provider.
LLM_PROVIDER=gemini    # or "openai"

# Gemini (https://ai.google.dev) — free tier works for small runs.
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com) — only needed if LLM_PROVIDER=openai.
OPENAI_API_KEY=

# OPTIONAL: QuickEnrich (https://quickenrich.io) — adds named contacts per company.
# Leave blank to skip contact enrichment.
QUICKENRICH_API_KEY=

# OPTIONAL tuning.
SCRAPE_TIMEOUT=60
